{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Example.Api.Middlewares": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId: {TraceId}] {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 50,
      "MaxRequestBodySize": 1048576, // 1MB
      "MaxRequestBufferSize": 1048576, // 1MB
      "MaxResponseBufferSize": 65536, // 64KB
      "MaxRequestHeadersTotalSize": 32768, // 32KB
      "MaxRequestHeaderCount": 100,
      "MaxRequestLineSize": 8192, // 8KB
      "KeepAliveTimeout": "00:01:00",
      "RequestHeadersTimeout": "00:00:30"
    },
    "AddServerHeader": false,
    "AllowSynchronousIO": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // This is not a real connection string. Replace with your actual development database connection string.
    // This ASP.NET Core project is using dotnet user-secrets to manage sensitive configuration data in development.
    "DefaultConnection": "Host=pgsql;Database={{your_database}};Username={{your_username}};Password={{your_password}};Pooling=true;MinPoolSize=10;MaxPoolSize=100",
    "DefaultRedisConnection": "redis-cache:6379,password={{your_redis_password}},defaultDatabase=0,keepAlive=15,connectTimeout=3000,syncTimeout=3000,abortConnect=false"
  },
  "CacheOptions": {
    "AbsoluteExpirationRelativeToNowMinutes": 10,
    "SlidingExpirationMinutes": 2
  },
  "RequestResponseLoggingOptions": {
    "EnabledRequestLog": true,
    "EnabledResponseLog": true
  }
}
