{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/csharp/jubo-example-api.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/csharp/api/api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/csharp/api/api.csproj"
            ],
            "isBackground": true,
            "problemMatcher": {
                "base": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(dotnet watch|Building\\.\\.\\.|Starting)",
                    "endsPattern": "^(Application started\\.|Now listening on:|Content root path:)"
                }
            }
        },
        {
            "label": "npm: install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/src/nodejs"
            },
            "group": "build"
        },
        {
            "label": "docker: start-db",
            "type": "shell",
            "command": "docker-compose --env-file .env -f ./docker/pg-docker-compose.yml up -d",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}